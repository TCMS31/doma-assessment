<% if flash.any? %>
  <div class="space-y-2" role="status" aria-live="polite">
    <% flash.each do |type, message| %>
      <% styles = type.to_s == "alert" ? "border-ochre-200 bg-ochre-50 text-ochre-900" : "border-moss-200 bg-moss-50 text-moss-900" %>
      <p class="rounded-lg border px-4 py-3 text-sm <%= styles %>"><%= message %></p>
    <% end %>
  </div>
<% end %>
