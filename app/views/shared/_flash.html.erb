<% if flash.any? %>
  <div class="space-y-2" role="status" aria-live="polite">
    <% flash.each do |type, message| %>
      <% styles = type.to_s == "alert" ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-300 bg-emerald-50 text-emerald-900" %>
      <p class="rounded-lg border px-4 py-3 text-sm <%= styles %>"><%= message %></p>
    <% end %>
  </div>
<% end %>
