<%# The visitor's answers so far, oldest first. %>
<ol class="mt-4 space-y-3">
  <% steps.each_with_index do |step, index| %>
    <li class="flex items-start gap-3 text-sm">
      <span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-moss-100 text-[11px] font-semibold tabular-nums text-moss-800"><%= index + 1 %></span>
      <span class="text-stone-700">
        <%= step["statement"] %>?
        <span class="font-semibold text-ink"><%= step["answer_type"].humanize %></span>
        <span class="text-stone-600">— <%= step["context"] %></span>
      </span>
    </li>
  <% end %>
</ol>
