<% content_for :title, t(".step", number: @step_number, total: @total_steps) %>

<section aria-labelledby="question-heading" class="rounded-xl border border-stone-300 bg-white p-6 shadow-sm sm:p-10">
  <div class="flex items-center justify-between gap-4">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-moss-700">
      <%= t(".step", number: @step_number, total: @total_steps) %>
    </p>
    <span class="font-mono text-xs text-stone-600"><%= @question.external_id %></span>
  </div>

  <progress class="progress-track mt-3 h-1.5 w-full" max="<%= @total_steps %>" value="<%= @step_number %>"
            aria-label="<%= t('.step', number: @step_number, total: @total_steps) %>"></progress>

  <h1 id="question-heading" class="mt-6 font-display text-3xl font-semibold leading-snug tracking-tight text-ink sm:text-4xl">
    <%= @question.statement %>?
  </h1>

  <div class="mt-8 grid gap-3 sm:grid-cols-2">
    <% @question.answers.each do |answer| %>
      <%= button_to answer.label, submit_answer_questions_path,
            params: { answer: answer.answer_type, question: @question.external_id },
            form_class: "contents",
            class: "w-full rounded-lg border-2 border-stone-300 bg-paper px-6 py-4 text-lg font-semibold text-ink transition hover:border-moss-600 hover:bg-moss-50 hover:text-moss-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss-700" %>
    <% end %>
  </div>
</section>

<% if @progress.started? %>
  <section aria-labelledby="trail-heading" class="mt-6 rounded-xl border border-dashed border-stone-300 p-6">
    <h2 id="trail-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-600">
      <%= t(".your_answers") %>
    </h2>
    <%= render "trail", steps: @progress.steps %>
  </section>
<% end %>
