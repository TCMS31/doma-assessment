<% content_for :title, t(".heading") %>
<% conclusive = @match.conclusive? %>

<section aria-labelledby="result-heading"
         class="rounded-xl border p-6 shadow-sm sm:p-10 <%= conclusive ? 'border-moss-200 bg-moss-50' : 'border-ochre-200 bg-ochre-50' %>">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] <%= conclusive ? 'text-moss-700' : 'text-ochre-700' %>">
    <%= t(".heading") %>
  </p>

  <% if conclusive %>
    <h1 id="result-heading" class="mt-3 font-display text-5xl font-semibold capitalize tracking-tight text-moss-900 sm:text-6xl">
      <%= @match.conclusion.name %>
    </h1>
    <p class="mt-3 text-base text-moss-900">
      <%= t(".conclusive", name: @match.conclusion.name) %>
    </p>
  <% else %>
    <h1 id="result-heading" class="mt-3 font-display text-3xl font-semibold tracking-tight text-ochre-900 sm:text-4xl">
      <%= t(".inconclusive") %>
    </h1>
    <% if @match.best %>
      <p class="mt-3 text-base text-ochre-900">
        <%= t(".closest") %>:
        <span class="font-semibold capitalize"><%= @match.best.conclusion.name %></span>
        (<%= t(".explains", percentage: @match.best.percentage) %>).
        <%= t(".unexplained") %>:
        <span class="font-semibold"><%= @match.best.unexplained.to_sentence %></span>.
      </p>
    <% end %>
  <% end %>

  <%= link_to t(".start_again"), questions_path,
        class: "mt-8 inline-flex w-full items-center justify-center rounded-lg bg-ink px-5 py-3 text-sm font-semibold text-paper shadow-sm transition hover:bg-stone-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink sm:w-auto" %>
</section>

<section aria-labelledby="answers-heading" class="mt-6 rounded-xl border border-dashed border-stone-300 p-6 sm:p-8">
  <h2 id="answers-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-600">
    <%= t(".your_answers") %>
  </h2>
  <%= render "trail", steps: @steps %>
</section>

<section aria-labelledby="candidates-heading" class="mt-6 rounded-xl border border-stone-300 bg-white p-6 sm:p-8">
  <h2 id="candidates-heading" class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-600">
    <%= t(".also_considered") %>
  </h2>
  <ul class="mt-4 space-y-5">
    <% @match.candidates.each do |candidate| %>
      <li>
        <div class="flex items-baseline justify-between gap-4">
          <span class="font-display text-lg font-semibold capitalize text-ink"><%= candidate.conclusion.name %></span>
          <span class="text-sm tabular-nums text-stone-700"><%= t(".fits", percentage: candidate.percentage) %></span>
        </div>
        <progress aria-hidden="true" max="100" value="<%= candidate.percentage %>"
                  class="mt-1.5 h-1.5 w-full <%= candidate.exact? ? 'progress-track' : 'progress-track progress-muted' %>"></progress>
        <p class="mt-1.5 text-xs text-stone-600">
          <%= t(".accepts", contexts: candidate.conclusion.context.to_sentence) %>
        </p>
      </li>
    <% end %>
  </ul>
</section>
