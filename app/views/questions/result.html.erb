<% content_for :title, t("questions.result.heading") %>
<% conclusive = @match.conclusive? %>

<section class="rounded-2xl border p-8 shadow-sm sm:p-10 <%= conclusive ? 'border-emerald-200 bg-emerald-50' : 'border-amber-200 bg-amber-50' %>">
  <p class="text-xs font-medium uppercase tracking-widest <%= conclusive ? 'text-emerald-700' : 'text-amber-700' %>">
    <%= t("questions.result.heading") %>
  </p>

  <% if conclusive %>
    <h1 class="mt-3 text-4xl font-semibold capitalize tracking-tight text-emerald-950 sm:text-5xl">
      <%= @match.conclusion.name %>
    </h1>
    <p class="mt-3 text-sm text-emerald-900">
      <%= t("questions.result.conclusive", name: @match.conclusion.name) %>
    </p>
  <% else %>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-amber-950 sm:text-3xl">
      <%= t("questions.result.inconclusive") %>
    </h1>
    <% if @match.best %>
      <p class="mt-3 text-sm text-amber-900">
        <%= t("questions.result.closest") %>:
        <span class="font-semibold capitalize"><%= @match.best.conclusion.name %></span>
        (<%= t("questions.result.explains", percentage: @match.best.percentage) %>).
        <%= t("questions.result.unexplained") %>:
        <span class="font-semibold"><%= @match.best.unexplained.to_sentence %></span>.
      </p>
    <% end %>
  <% end %>

  <%= link_to t("questions.result.start_again"), questions_path,
        class: "mt-8 inline-flex items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
  <h2 class="text-xs font-medium uppercase tracking-widest text-slate-500">
    <%= t("questions.result.your_answers") %>
  </h2>
  <ol class="mt-4 space-y-3">
    <% @steps.each_with_index do |step, index| %>
      <li class="flex items-start gap-3 text-sm">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[11px] font-semibold text-slate-600 tabular-nums"><%= index + 1 %></span>
        <span class="text-slate-600">
          <%= step["statement"] %>?
          <span class="font-semibold text-slate-900"><%= step["answer_type"].humanize %></span>
          <span class="text-slate-400">— <%= step["context"] %></span>
        </span>
      </li>
    <% end %>
  </ol>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
  <h2 class="text-xs font-medium uppercase tracking-widest text-slate-500">
    <%= t("questions.result.also_considered") %>
  </h2>
  <ul class="mt-4 space-y-4">
    <% @match.candidates.each do |candidate| %>
      <li>
        <div class="flex items-baseline justify-between gap-4 text-sm">
          <span class="font-semibold capitalize text-slate-900"><%= candidate.conclusion.name %></span>
          <span class="tabular-nums text-slate-500"><%= candidate.percentage %>%</span>
        </div>
        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full <%= candidate.exact? ? 'bg-emerald-500' : 'bg-slate-300' %>"
               style="width: <%= candidate.percentage %>%"></div>
        </div>
        <p class="mt-1.5 text-xs text-slate-400">
          Accepts: <%= candidate.conclusion.context.to_sentence %>
        </p>
      </li>
    <% end %>
  </ul>
</section>
