<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= [yield(:title).presence, t("app.name")].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f7f2e8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="h-full bg-paper font-sans text-ink antialiased">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-sm focus:text-paper">
      <%= t("app.skip_to_content") %>
    </a>
    <div class="mx-auto flex min-h-full w-full max-w-2xl flex-col gap-8 px-4 py-8 sm:px-6 sm:py-14">
      <header class="flex items-center justify-between gap-4 border-b border-stone-300 pb-5">
        <%= link_to root_path, class: "group inline-flex items-center gap-3 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-moss-600" do %>
          <svg aria-hidden="true" viewBox="0 0 32 32" class="h-8 w-8 text-moss-700">
            <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="1.5" />
            <ellipse cx="16" cy="20.5" rx="5.2" ry="4.2" fill="currentColor" />
            <ellipse cx="9.6" cy="14.2" rx="2" ry="2.6" fill="currentColor" />
            <ellipse cx="13.6" cy="10.4" rx="2" ry="2.7" fill="currentColor" />
            <ellipse cx="18.4" cy="10.4" rx="2" ry="2.7" fill="currentColor" />
            <ellipse cx="22.4" cy="14.2" rx="2" ry="2.6" fill="currentColor" />
          </svg>
          <span class="font-display text-xl font-semibold tracking-tight text-ink group-hover:text-moss-700"><%= t("app.name") %></span>
        <% end %>
        <span class="hidden text-xs uppercase tracking-[0.2em] text-stone-600 sm:inline"><%= t("app.kicker") %></span>
      </header>

      <%= render "shared/flash" %>

      <main id="content" class="flex flex-1 flex-col"><%= yield %></main>

      <footer class="border-t border-stone-300 pt-5 text-xs text-stone-600">
        <%= t("app.footer_html") %>
      </footer>
    </div>
  </body>
</html>
