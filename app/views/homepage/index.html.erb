<section aria-labelledby="home-heading" class="py-4 sm:py-8">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-moss-700"><%= t("homepage.index.eyebrow") %></p>
  <h1 id="home-heading" class="mt-3 font-display text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl">
    <%= t("homepage.index.heading") %>
  </h1>
  <p class="mt-5 max-w-prose text-base leading-relaxed text-stone-700 sm:text-lg">
    <%= t("app.tagline") %>
  </p>

  <% if @question_count.positive? %>
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-y border-dashed border-stone-300 py-5">
      <div>
        <dt class="text-xs uppercase tracking-wide text-stone-600"><%= t("homepage.index.questionnaire") %></dt>
        <dd class="mt-1 font-display text-2xl text-ink">
          <%= t("homepage.index.questions_available", count: @question_count) %>
        </dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-stone-600"><%= t("homepage.index.outcomes") %></dt>
        <dd class="mt-1 font-display text-2xl text-ink">
          <%= t("homepage.index.conclusions_available", count: @conclusion_count) %>
        </dd>
      </div>
    </dl>

    <%= link_to t("homepage.index.start"), questions_path,
          class: "mt-8 inline-flex w-full items-center justify-center rounded-lg bg-moss-700 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-moss-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-moss-700 sm:w-auto" %>
  <% else %>
    <div class="mt-8 rounded-lg border border-ochre-200 bg-ochre-50 px-5 py-4 text-sm text-ochre-900">
      <p class="font-semibold"><%= t("homepage.index.empty_heading") %></p>
      <p class="mt-1"><%= t("homepage.index.not_imported_html") %></p>
    </div>
  <% end %>
</section>
