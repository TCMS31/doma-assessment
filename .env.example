# Copy to .env and adjust. Nothing here is required for local development
# beyond a reachable PostgreSQL.

# Full connection string. Overrides config/database.yml when set.
# DATABASE_URL=postgres://localhost:5432/doma_test_development

# Connection pool size (defaults to 5).
# RAILS_MAX_THREADS=5

# Required in production only; generate with `bin/rails secret`.
# SECRET_KEY_BASE=

# Which questionnaire source adapter to use, and what to hand it.
# QUESTIONNAIRE_SOURCE=json_file
# QUESTIONNAIRE_PATH=data.json
